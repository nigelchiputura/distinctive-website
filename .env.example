# Copy to .env (never commit .env). Local development values; production: .env.prod.example (Day 9).
DJANGO_SETTINGS_MODULE=config.settings.dev
# 50+ random characters. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me

# Postgres (the compose db service reads POSTGRES_*; the app reads DATABASE_URL)
POSTGRES_USER=dcs
POSTGRES_PASSWORD=dcs
POSTGRES_DB=dcs
DATABASE_URL=postgres://dcs:dcs@db:5432/dcs

ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
SITE_URL=http://localhost:8000
ADMIN_URL_PATH=admin/

# First deploy only, from Day 5: load the old site's content.
SEED_SITE_CONTENT=false
