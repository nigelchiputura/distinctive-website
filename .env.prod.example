# Production settings (docs/deployment.md §3). On the VPS: copy to /srv/distinctive/.env and fill
# in; never commit the real file. For the local prod stack (Day 10): copy to .env.prod in the repo
# root, keep ENV_FILE as below, and use SITE_DOMAIN=localhost.

DJANGO_SETTINGS_MODULE=config.settings.prod
# 50+ random characters:  python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# The image to run: ghcr.io/<GHCR_IMAGE>:<IMAGE_TAG>
GHCR_IMAGE=owner/distinctive-site
IMAGE_TAG=latest

# Postgres (the db service reads these; the web service builds DATABASE_URL from them)
POSTGRES_USER=dcs
POSTGRES_PASSWORD=
POSTGRES_DB=dcs

# The host Caddy serves. Preview: new.distinctive.co.zw; at cutover: distinctive.co.zw
SITE_DOMAIN=new.distinctive.co.zw
SITE_URL=https://new.distinctive.co.zw
ALLOWED_HOSTS=new.distinctive.co.zw
CSRF_TRUSTED_ORIGINS=https://new.distinctive.co.zw
# true on the preview host (kept out of search engines); remove at cutover
SEO_NOINDEX=true

# Something not guessable, ending in /
ADMIN_URL_PATH=change-me-admin/

# Email through Resend (docs/deployment.md §6)
EMAIL_PROVIDER=resend
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=Distinctive Website <website@mail.distinctive.co.zw>
CONTACT_RECIPIENT=enquiries@distinctive.co.zw

# Google sign-in (docs/users.md §3); leave empty to hide the button
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Analytics 4 (or set it in the admin's Site settings) and the Contact map
GA_MEASUREMENT_ID=
GOOGLE_MAPS_EMBED_KEY=

# First deploy only: load the old site's content, then remove this line
SEED_SITE_CONTENT=true

# Defaults that rarely change:
# SECURE_SSL_REDIRECT=true
# SECURE_HSTS_SECONDS=604800
# TRUSTED_PROXY_COUNT=1
# CONTACT_RATE_LIMIT=5

# Local prod stack only: where docker-compose.prod.yml finds this file (relative to docker/)
# ENV_FILE=../.env.prod
